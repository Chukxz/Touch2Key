# === Project Specifics ===

# Ignore Drivers, Binaries, and Platform Tools
# These are OS-specific and large; they should be managed via setup scripts, not Git
bin/

# === Python Junk ===
__pycache__/
*.py[cod]
*$py.class
.env
.venv
env/
venv/
ENV/
.pytest_cache/
.tox/
.coverage
htmlcov/

# Ignore all TOML files everywhere
*.toml
**/*.toml

# Allow pyproject.toml at the root (and subdirectories if applicable)
!pyproject.toml
!**/pyproject.toml

# === Distribution / Build ===
dist/
build/
*.egg-info/

# === Editor Specifics ===
.vscode/
.idea/

# === Operating System / Misc ===
.DS_Store
Thumbs.db
*~
*.bak
.adbkey

# Runtime Logs & Performance Telemetry
logs/
diagnostics/
*.log
*.prof

# === SQLite databases ===
*.sqlite
*.sqlite3
*.db

# === User data ===
data/